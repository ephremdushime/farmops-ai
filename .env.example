MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
FLASK_SECRET_KEY=
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# Booting refuses to start when FLASK_SECRET_KEY is empty.
FLASK_DEBUG=false
# FARMOPS_ENV defaults to production (Secure cookies, https redirect, HSTS, no debug).
# Set FARMOPS_ENV=development for local http work only; never in production.
FARMOPS_ENV=
FARMOPS_ENV_FILE=
PORT=5000
# PORT is read by the dev server; gunicorn binds $PORT via the Procfile/Docker CMD.
FARMOPS_DB_PATH=
# Default: <repo>/farmops.db. Point at a volume path in production.
FARMOPS_UPLOAD_DIR=
# Default: <repo>/instance/uploads. Point at a volume path in production.
